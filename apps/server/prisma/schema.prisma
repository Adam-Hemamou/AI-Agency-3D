// Schéma de la base de données (Prisma + MySQL).
//
// Les valeurs autorisées (statuts, salles, actions…) sont définies UNE SEULE FOIS
// dans packages/shared. Les colonnes correspondantes sont donc des chaînes, et seul
// le service de missions du serveur écrit dans ces tables, après validation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Une unité de travail confiée à une salle de l'agence.
model Mission {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  /// Type de mission (ex. "search_creators"). Format validé par missionTypeSchema.
  type               String    @db.VarChar(64)
  /// Identifiant de salle (ROOM_IDS).
  room               String    @db.VarChar(32)
  /// Statut (MISSION_STATUSES). Modifié uniquement via le moteur de missions.
  status             String    @default("pending") @db.VarChar(32)
  /// 1 (très basse) à 5 (critique).
  priority           Int       @default(3) @db.TinyInt
  /// Données d'entrée (objet JSON).
  input              Json
  /// Résultat produit (objet JSON), null tant qu'aucun résultat n'a été transmis.
  output             Json?
  /// Fixé à la création : la mission ne peut être terminée qu'après approbation humaine.
  requiresValidation Boolean   @default(false) @map("requires_validation")
  /// Dernier résultat de validation (VALIDATION_OUTCOMES).
  validationOutcome  String?   @map("validation_outcome") @db.VarChar(32)
  validatedAt        DateTime? @map("validated_at") @db.DateTime(3)
  validatedBy        String?   @map("validated_by") @db.VarChar(64)
  /// Agent responsable (identifiant d'agent). Pas de clé étrangère : les missions existantes peuvent
  /// citer des agents qui n'ont pas (encore) d'identité enregistrée.
  agentId            String?   @map("agent_id") @db.VarChar(64)
  /// Nombre de démarrages effectués (une reprise après pause n'en est pas un).
  attemptCount       Int       @default(0) @map("attempt_count")
  maxAttempts        Int       @default(3) @map("max_attempts")
  /// Dernière erreur (renseignée lors d'un blocage, effacée au déblocage).
  lastErrorCode      String?   @map("last_error_code") @db.VarChar(64)
  lastErrorMessage   String?   @map("last_error_message") @db.Text
  /// Incrémentée à chaque modification : protège contre les modifications concurrentes.
  version            Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  /// Premier démarrage.
  startedAt          DateTime? @map("started_at") @db.DateTime(3)
  /// Passage à un état final (terminée ou annulée).
  finishedAt         DateTime? @map("finished_at") @db.DateTime(3)
  /// Prospect concerné (dossier central). Null pour les missions sans prospect.
  prospectId         String?   @map("prospect_id") @db.Char(36)

  events   MissionEvent[]
  runs     AgentRun[]
  prospect Prospect?      @relation(fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, priority])
  @@index([room, status])
  @@index([type])
  @@index([createdAt])
  @@index([prospectId])
  @@map("missions")
}

/// Historique d'une mission. Ajout uniquement : la base refuse toute modification ou suppression.
model MissionEvent {
  id         Int      @id @default(autoincrement())
  missionId  String   @map("mission_id") @db.Char(36)
  /// MISSION_EVENT_ACTIONS ("created", "start", "approve"…).
  action     String   @db.VarChar(48)
  /// ACTOR_TYPES : user, agent ou system.
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.VarChar(64)
  fromStatus String?  @map("from_status") @db.VarChar(32)
  toStatus   String   @map("to_status") @db.VarChar(32)
  /// Champs modifiés : { "champ": { "from": ..., "to": ... } }.
  changes    Json
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([missionId, id])
  @@map("mission_events")
}

// ---------------------------------------------------------------------------
// Agents IA : identité et clés API. Seul le service des agents écrit dans ces tables.
// ---------------------------------------------------------------------------

/// Un agent IA de l'agence. Son identifiant commence toujours par "agent-" (agentIdSchema).
model Agent {
  /// Ex. "agent-prospecteur". Repris tel quel dans les colonnes actor_id de l'historique.
  id          String   @id @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  /// Salle de rattachement (ROOM_IDS), facultative.
  room        String?  @db.VarChar(32)
  /// AGENT_STATUSES. "disabled" : toutes ses clés sont refusées.
  status      String   @default("active") @db.VarChar(16)
  createdAt   DateTime @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @map("updated_at") @db.DateTime(3)

  apiKeys     AgentApiKey[]
  permissions AgentPermission[]
  requests    AgentRequest[]
  profile     AgentProfile?
  prompts     AgentPrompt[]
  runs        AgentRun[]

  @@map("agents")
}

/// Clé API d'un agent. Le secret n'est jamais stocké : seule son empreinte SHA-256 l'est.
model AgentApiKey {
  id         String    @id @default(uuid(7)) @db.Char(36)
  agentId    String    @map("agent_id") @db.VarChar(64)
  /// Partie publique de la clé ("agk_" + 12 caractères) : sert à la retrouver sans la révéler.
  prefix     String    @unique @db.VarChar(24)
  /// Empreinte SHA-256 (hexadécimal) de la clé complète.
  secretHash String    @map("secret_hash") @db.Char(64)
  label      String?   @db.VarChar(120)
  createdAt  DateTime  @map("created_at") @db.DateTime(3)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)
  /// Une clé révoquée ne peut jamais être réactivée.
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([agentId])
  @@map("agent_api_keys")
}

/// Permission accordée à un agent par l'utilisateur (AGENT_PERMISSIONS). Aucune par défaut.
model AgentPermission {
  agentId    String   @map("agent_id") @db.VarChar(64)
  permission String   @db.VarChar(48)
  grantedAt  DateTime @map("granted_at") @db.DateTime(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([agentId, permission])
  @@map("agent_permissions")
}

/// Profil IA d'un agent (une ligne au plus par agent ; absente = valeurs par défaut, AGENT_MODEL_DEFAULTS).
/// Modifié par l'utilisateur uniquement, via le service des profils.
model AgentProfile {
  agentId             String   @id @map("agent_id") @db.VarChar(64)
  /// AGENT_ROLES, facultatif.
  role                String?  @db.VarChar(16)
  /// Modèle Ollama (ex. "qwen3:8b").
  model               String   @db.VarChar(64)
  temperature         Float
  topP                Float    @map("top_p")
  topK                Int      @map("top_k")
  numCtx              Int      @map("num_ctx")
  numPredict          Int      @map("num_predict")
  /// false : pas de bloc de raisonnement dans la réponse (Qwen3).
  think               Boolean
  timeoutSeconds      Int      @map("timeout_seconds")
  /// Version du prompt utilisée (clé étrangère vers agent_prompts), null = aucune.
  activePromptVersion Int?     @map("active_prompt_version")
  createdAt           DateTime @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @map("updated_at") @db.DateTime(3)
  updatedBy           String   @map("updated_by") @db.VarChar(64)

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activePrompt AgentPrompt? @relation("ActivePrompt", fields: [agentId, activePromptVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict)

  @@map("agent_profiles")
}

/// Version du prompt système d'un agent. Ajout uniquement : la base refuse toute modification
/// ou suppression ; une modification crée une nouvelle version.
model AgentPrompt {
  agentId      String   @map("agent_id") @db.VarChar(64)
  /// 1, 2, 3… par agent.
  version      Int
  systemPrompt String   @map("system_prompt") @db.MediumText
  note         String?  @db.VarChar(500)
  createdAt    DateTime @map("created_at") @db.DateTime(3)
  createdBy    String   @map("created_by") @db.VarChar(64)

  agent    Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeIn AgentProfile[] @relation("ActivePrompt")
  runs     AgentRun[]

  @@id([agentId, version])
  @@map("agent_prompts")
}

/// Exécution : une tentative de travail d'un agent sur une mission (orchestrée par n8n).
/// Au plus une exécution « started » par mission (colonne générée et index unique, en SQL).
/// Une exécution terminée n'est plus modifiable (trigger). Seul le service des exécutions y écrit.
model AgentRun {
  id             String    @id @default(uuid(7)) @db.Char(36)
  missionId      String    @map("mission_id") @db.Char(36)
  agentId        String    @map("agent_id") @db.VarChar(64)
  /// attemptCount de la mission au démarrage de cette exécution.
  attempt        Int
  /// AGENT_RUN_STATUSES.
  status         String    @default("started") @db.VarChar(16)
  /// Exécution n8n à l'origine (une seule prise de mission par exécution n8n et par agent).
  n8nExecutionId String?   @map("n8n_execution_id") @db.VarChar(128)
  /// Version du prompt utilisée (clé étrangère vers agent_prompts).
  promptVersion  Int       @map("prompt_version")
  /// Copie des paramètres du modèle utilisés (AgentModelSettings).
  settings       Json
  startedAt      DateTime  @map("started_at") @db.DateTime(3)
  /// Dernier signal de vie reçu de n8n.
  heartbeatAt    DateTime? @map("heartbeat_at") @db.DateTime(3)
  finishedAt     DateTime? @map("finished_at") @db.DateTime(3)
  /// AGENT_RUN_FAILURE_CODES (échec signalé) ou INTERRUPTED (récupération).
  failureCode    String?   @map("failure_code") @db.VarChar(64)
  failureMessage String?   @map("failure_message") @db.Text
  /// Sortie brute du modèle, conservée uniquement en cas de rejet.
  rawOutput      String?   @map("raw_output") @db.MediumText
  promptTokens   Int?      @map("prompt_tokens")
  outputTokens   Int?      @map("output_tokens")
  llmMs          Int?      @map("llm_ms")

  mission Mission     @relation(fields: [missionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  agent   Agent       @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prompt  AgentPrompt @relation(fields: [agentId, promptVersion], references: [agentId, version], onDelete: Restrict, onUpdate: Restrict)

  @@unique([agentId, n8nExecutionId])
  @@index([missionId, status])
  @@index([agentId, startedAt])
  @@index([status, heartbeatAt])
  /// Journal des exécutions (GET /api/runs) : tri chronologique sans tri en mémoire.
  @@index([startedAt, id])
  @@map("agent_runs")
}

/// Écriture demandée par un agent, identifiée par sa clé d'idempotence (en-tête Idempotency-Key).
/// Une requête répétée avec la même clé renvoie la réponse enregistrée, sans nouvelle exécution.
model AgentRequest {
  id             Int       @id @default(autoincrement())
  agentId        String    @map("agent_id") @db.VarChar(64)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  /// Empreinte SHA-256 de la méthode, du chemin et du corps : la même clé ne sert qu'à une requête.
  requestHash    String    @map("request_hash") @db.Char(64)
  method         String    @db.VarChar(8)
  path           String    @db.VarChar(500)
  /// "completed" (lot C : enregistrée dans la transaction de l'écriture, donc jamais à moitié).
  /// "processing" ne subsiste que pour des requêtes interrompues avant le lot C.
  status         String    @db.VarChar(16)
  responseStatus Int?      @map("response_status")
  /// Ancienne version (étape 2) : réponse complète enregistrée. Plus écrite ; lue seulement pour les
  /// requêtes enregistrées avant le lot C, effacées au bout de 7 jours.
  responseBody   Json?     @map("response_body")
  /// Ressource écrite par la requête ("prospect" ou "mission") : une répétition renvoie son état actuel.
  resourceType   String?   @map("resource_type") @db.VarChar(16)
  resourceId     String?   @map("resource_id") @db.VarChar(36)
  /// Pour une mission : l'événement d'historique produit.
  eventId        Int?      @map("event_id")
  createdAt      DateTime  @map("created_at") @db.DateTime(3)
  completedAt    DateTime? @map("completed_at") @db.DateTime(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([agentId, idempotencyKey])
  @@index([createdAt])
  @@map("agent_requests")
}

// ---------------------------------------------------------------------------
// CRM : un dossier unique par prospect, enrichi salle après salle.
// Seul le service des prospects écrit dans ces tables.
// ---------------------------------------------------------------------------

/// Le créateur ou l'entreprise prospecté. Son identité ne change pas d'une salle à l'autre.
model Prospect {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  /// Numéro de dossier lisible (ex. "P-2026-0001").
  reference          String    @unique @db.VarChar(20)
  creatorName        String    @map("creator_name") @db.VarChar(120)
  channelName        String    @map("channel_name") @db.VarChar(160)
  channelHandle      String?   @map("channel_handle") @db.VarChar(120)
  /// Identifiant YouTube de la chaîne : empêche de créer deux dossiers pour la même chaîne.
  youtubeChannelId   String?   @unique @map("youtube_channel_id") @db.VarChar(64)
  channelUrl         String?   @map("channel_url") @db.VarChar(500)
  /// Nom de chaîne normalisé (channelHandleKey) : deux dossiers ne peuvent pas avoir le même.
  channelHandleKey   String?   @unique @map("channel_handle_key") @db.VarChar(120)
  /// Adresse de chaîne normalisée (channelUrlKey) : deux dossiers ne peuvent pas avoir la même.
  channelUrlKey      String?   @unique @map("channel_url_key") @db.VarChar(500)
  avatarUrl          String?   @map("avatar_url") @db.VarChar(500)
  category           String?   @db.VarChar(80)
  description        String?   @db.Text
  country            String?   @db.VarChar(80)
  /// Statistiques facultatives : toujours accompagnées de leur source et de leur date de relevé.
  subscriberCount    Int?      @map("subscriber_count")
  viewCount          BigInt?   @map("view_count")
  videoCount         Int?      @map("video_count")
  statsSource        String?   @map("stats_source") @db.VarChar(200)
  statsUpdatedAt     DateTime? @map("stats_updated_at") @db.DateTime(3)
  contactEmail       String?   @map("contact_email") @db.VarChar(254)
  contactName        String?   @map("contact_name") @db.VarChar(120)
  contactSource      String?   @map("contact_source") @db.VarChar(200)
  /// Contexte de la découverte et qualification initiale (schéma discoverySchema).
  discovery          Json?
  /// Étape du parcours (PROSPECT_STAGES).
  stage              String    @default("prospecting") @db.VarChar(32)
  /// Statut de la relation commerciale (RELATIONSHIP_STATUSES), à partir du premier envoi.
  relationshipStatus String?   @map("relationship_status") @db.VarChar(32)
  priority           Int       @default(3) @db.TinyInt
  /// Le prospect a refusé ou demandé à ne plus être contacté : toute relance est bloquée.
  doNotContact       Boolean   @default(false) @map("do_not_contact")
  doNotContactReason String?   @map("do_not_contact_reason") @db.VarChar(500)
  nextAction         String?   @map("next_action") @db.VarChar(500)
  nextActionAt       DateTime? @map("next_action_at") @db.DateTime(3)
  /// Données fictives de démonstration.
  isDemo             Boolean   @default(false) @map("is_demo")
  version            Int       @default(0)
  discoveredAt       DateTime  @map("discovered_at") @db.DateTime(3)
  lastActivityAt     DateTime  @map("last_activity_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  missions    Mission[]
  analyses    ProspectAnalysis[]
  productions ProspectProduction[]
  decisions   ProspectDecision[]
  messages    ProspectMessage[]
  events      ProspectEvent[]

  @@index([stage, priority])
  @@index([lastActivityAt])
  @@map("prospects")
}

/// Dernier numéro de dossier attribué, par année (P-AAAA-NNNN). Ligne verrouillée pendant une création :
/// deux créations simultanées ne peuvent pas recevoir le même numéro.
model ProspectCounter {
  year       Int @id
  lastNumber Int @map("last_number")

  @@map("prospect_counters")
}

/// Résultat d'une analyse. Jamais modifié : une nouvelle analyse crée une nouvelle version.
model ProspectAnalysis {
  id            String   @id @default(uuid(7)) @db.Char(36)
  prospectId    String   @map("prospect_id") @db.Char(36)
  missionId     String?  @map("mission_id") @db.Char(36)
  version       Int
  summary       String   @db.Text
  conclusion    String   @db.Text
  score         Int?     @db.TinyInt
  scoreCriteria Json     @map("score_criteria")
  priority      Int      @db.TinyInt
  /// Détail de l'analyse (schéma analysisContentSchema).
  content       Json
  sources       Json
  actorType     String   @map("actor_type") @db.VarChar(16)
  actorId       String?  @map("actor_id") @db.VarChar(64)
  createdAt     DateTime @map("created_at") @db.DateTime(3)

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([prospectId, version])
  @@map("prospect_analyses")
}

/// Élément produit pour le prospect : extrait, doublage, proposition, e-mail. Versionné.
model ProspectProduction {
  id         String   @id @default(uuid(7)) @db.Char(36)
  prospectId String   @map("prospect_id") @db.Char(36)
  missionId  String?  @map("mission_id") @db.Char(36)
  /// PRODUCTION_KINDS.
  kind       String   @db.VarChar(32)
  /// Numéro de version, par prospect et par type.
  version    Int
  /// PRODUCTION_STATUSES.
  status     String   @db.VarChar(32)
  title      String?  @db.VarChar(250)
  /// Contenu selon le type (productionContentSchemas).
  content    Json
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.VarChar(64)
  createdAt  DateTime @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @map("updated_at") @db.DateTime(3)

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([prospectId, kind, version])
  @@map("prospect_productions")
}

/// Décision humaine (validation, refus, nouvelle analyse, décision sur un e-mail).
model ProspectDecision {
  id           String   @id @default(uuid(7)) @db.Char(36)
  prospectId   String   @map("prospect_id") @db.Char(36)
  missionId    String?  @map("mission_id") @db.Char(36)
  productionId String?  @map("production_id") @db.Char(36)
  /// DECISION_KINDS.
  kind         String   @db.VarChar(48)
  reason       String?  @db.Text
  actorType    String   @map("actor_type") @db.VarChar(16)
  actorId      String?  @map("actor_id") @db.VarChar(64)
  createdAt    DateTime @map("created_at") @db.DateTime(3)

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([prospectId, createdAt])
  @@map("prospect_decisions")
}

/// E-mail envoyé ou reçu. "simulated" : rien n'est réellement parti.
model ProspectMessage {
  id           String   @id @default(uuid(7)) @db.Char(36)
  prospectId   String   @map("prospect_id") @db.Char(36)
  productionId String?  @map("production_id") @db.Char(36)
  direction    String   @db.VarChar(16)
  kind         String   @db.VarChar(16)
  delivery     String   @db.VarChar(16)
  fromAddress  String?  @map("from_address") @db.VarChar(254)
  toAddress    String?  @map("to_address") @db.VarChar(254)
  subject      String?  @db.VarChar(250)
  body         String   @db.Text
  occurredAt   DateTime @map("occurred_at") @db.DateTime(3)
  createdAt    DateTime @map("created_at") @db.DateTime(3)

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([prospectId, occurredAt])
  @@map("prospect_messages")
}

/// Timeline du dossier. Ajout uniquement : la base refuse toute modification ou suppression.
model ProspectEvent {
  id         Int      @id @default(autoincrement())
  prospectId String   @map("prospect_id") @db.Char(36)
  missionId  String?  @map("mission_id") @db.Char(36)
  /// PROSPECT_EVENT_TYPES.
  type       String   @db.VarChar(48)
  /// Salle où l'événement s'est produit (ROOM_IDS).
  room       String?  @db.VarChar(32)
  title      String   @db.VarChar(250)
  details    String?  @db.Text
  payload    Json
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.VarChar(64)
  createdAt  DateTime @map("created_at") @db.DateTime(3)

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([prospectId, createdAt])
  @@map("prospect_events")
}

// ---------------------------------------------------------------------------
// Utilisateur humain : mot de passe administrateur et sessions.
// Seul le service d'authentification écrit dans ces tables.
// ---------------------------------------------------------------------------

/// Mot de passe administrateur (une seule ligne, id "owner"). Seule son empreinte scrypt est stockée.
model OwnerCredential {
  id           String   @id @db.VarChar(16)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  updatedAt    DateTime @map("updated_at") @db.DateTime(3)

  @@map("owner_credentials")
}

/// Session humaine ouverte par le mot de passe. Le jeton n'est jamais stocké : seulement son empreinte.
model OwnerSession {
  id         String    @id @default(uuid(7)) @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @map("created_at") @db.DateTime(3)
  /// Fin fixe : 12 heures après la connexion.
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.DateTime(3)
  /// Déconnexion, ou changement du mot de passe.
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)

  @@index([expiresAt])
  @@map("owner_sessions")
}

/// Quotas journaliers GLOBAUX des agents (tous agents confondus) : une ligne par jour et par action.
/// Incrémentée dans la transaction de l'écriture, ligne verrouillée jusqu'à la fin : limite exacte
/// même sous requêtes simultanées, et une écriture annulée n'est pas comptée.
model AgentQuotaUsage {
  /// Jour calendaire, heure de Paris (AAAA-MM-JJ).
  day    String @db.VarChar(10)
  /// AGENT_QUOTA_ACTIONS.
  action String @db.VarChar(32)
  used   Int

  @@id([day, action])
  @@map("agent_quota_usage")
}

/// Interrupteur d'arrêt d'urgence des agents, réglé par l'utilisateur (une seule ligne, id "global").
/// Conservé en base : un redémarrage ne réactive pas des agents arrêtés.
model AgentSwitch {
  id        String   @id @db.VarChar(16)
  enabled   Boolean
  updatedAt DateTime @map("updated_at") @db.DateTime(3)

  @@map("agent_switch")
}
