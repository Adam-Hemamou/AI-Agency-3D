# ------------------------------------------------------------
# Copier ce fichier en ".env" à la racine puis adapter les valeurs.
# Le fichier .env n'est jamais versionné.
# ------------------------------------------------------------

# Environnement : development | test | production
NODE_ENV=development

# Port de l'API Express
SERVER_PORT=3001

# Garde-fou : tant que "true", AUCUNE action externe réelle n'est autorisée
# (pas d'e-mail, pas d'appel HeyGen, pas d'appel YouTube).
MODE_SIMULATION=true

# Arrêt d'urgence des agents IA : "false" refuse toutes leurs opérations dès le démarrage
# (l'interface ne peut pas lever cet arrêt). L'utilisateur garde un accès normal au CRM.
AGENTS_ENABLED=true

# Noms d'hôte acceptés par l'API (en-tête Host) en plus de localhost / 127.0.0.1,
# séparés par des virgules. Vide par défaut. Exemples :
#   - n8n dans Docker sur ce PC : ALLOWED_HOSTS=host.docker.internal
#   - accès Tailscale (voir ci-dessous) : l'adresse TAILSCALE_BIND_ADDRESS doit y figurer.
ALLOWED_HOSTS=

# Missions interrompues : une mission « en cours » sans aucune activité depuis ce délai (minutes)
# passe en « bloquée » (jamais remise en attente automatiquement). De 5 à 10080 (7 jours).
MISSION_STALE_MINUTES=60

# (Facultatif) Accès du VPS via Tailscale : deuxième écoute, EN PLUS de 127.0.0.1 (inchangée,
# toujours ouverte à toutes les routes pour l'interface).
# - Les deux variables vont ensemble : renseignez les deux ou aucune (vide = local uniquement).
# - Adresses IPv4 Tailscale (100.64.0.0/10) en écriture décimale stricte ; 0.0.0.0, ::, les
#   adresses du réseau local et toute écriture ambiguë (zéros en tête, hexadécimal…) sont refusées.
# - Seule la machine TAILSCALE_ALLOWED_PEER peut s'y connecter, et uniquement sur /api/health,
#   /api/agent/… et GET /api/agents/me (identité de la clé ; GET seul, chemin exact). La clé API
#   d'agent (Authorization: Bearer) reste exigée comme d'habitude. Toute autre route y est
#   refusée, y compris la connexion à l'interface et l'administration des agents.
# - Lues au démarrage uniquement : redémarrez l'API après modification. Tailscale doit être
#   connecté au démarrage, sinon seule l'écoute locale démarre (redémarrer l'API ensuite).
# - Ignorées en mode démonstration (npm run dev:demo), qui reste toujours local.
# Exemple :
#   ALLOWED_HOSTS=100.90.1.10
#   TAILSCALE_BIND_ADDRESS=100.90.1.10
#   TAILSCALE_ALLOWED_PEER=100.90.2.20
TAILSCALE_BIND_ADDRESS=
TAILSCALE_ALLOWED_PEER=

# MySQL (conteneur Docker)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
# L'utilisateur "agency" et la base "ai_agency" sont créés par docker-compose.
DATABASE_URL=mysql://agency:change-me@localhost:3306/ai_agency

# (Facultatif) Base utilisée par les tests d'intégration. Par défaut : DATABASE_URL suffixée par "_test".
# Son nom DOIT se terminer par "_test" : elle est effacée à chaque exécution des tests.
# TEST_DATABASE_URL=mysql://agency:change-me@localhost:3306/ai_agency_test
