    {
      "id": "c0a80001-0000-4000-8000-000000000012",
      "name": "YouTube – recherche de vidéos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 200],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify($json.query) }}",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "credentials": { "httpQueryAuth": { "id": "", "name": "YouTube Data API" } }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000013",
      "name": "Chaînes trouvées",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2640, 200],
      "parameters": {
        "jsCode": "const plan = $('Plan de recherche').first().json;\nconst recherches = $('Une recherche par mot-clé').all();\nconst chaines = {};\nconst erreurs = [];\n$input.all().forEach((item, i) => {\n  const r = item.json;\n  const motCle = recherches[i] ? recherches[i].json.motCle : null;\n  if (r.error || !r.statusCode || r.statusCode >= 400) {\n    erreurs.push(r.body?.error?.message ?? r.error?.message ?? String(r.error ?? r.statusCode));\n    return;\n  }\n  for (const v of r.body?.items ?? []) {\n    const id = v.snippet?.channelId;\n    if (!id) continue;\n    const prec = chaines[id];\n    if (!prec || v.snippet.publishedAt > prec.derniereVideo) {\n      chaines[id] = { derniereVideo: v.snippet.publishedAt, titreVideo: v.snippet.title, motCle };\n    }\n  }\n});\nif (erreurs.length === recherches.length) {\n  return [{ json: { ...plan, ids: [], chaines: {}, echec: { code: 'WORKFLOW_ERROR', message: 'YouTube (recherche) : ' + erreurs[0] } } }];\n}\nconst ids = Object.keys(chaines).slice(0, 50);\nreturn [{ json: { ...plan, ids, chaines, erreursYoutube: erreurs, echec: null } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000014",
