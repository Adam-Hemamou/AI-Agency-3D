        },
        "options": {}
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000019",
      "name": "YouTube – détails des chaînes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3960, -100],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/channels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ part: 'snippet,statistics,status', id: $json.nouvelles.join(','), maxResults: 50 }) }}",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "credentials": { "httpQueryAuth": { "id": "", "name": "YouTube Data API" } }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000020",
      "name": "Filtrer et préparer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4180, -100],
      "parameters": {
        "jsCode": "const prec = $('Nouvelles chaînes').first().json;\nconst camp = $('Critères de la campagne').first().json.campaign;\nconst cfg = $('Configuration').first().json;\nconst r = $input.first().json;\nif (r.error || !r.statusCode || r.statusCode >= 400) {\n  const detail = r.body?.error?.message ?? r.error?.message ?? String(r.error ?? r.statusCode);\n  return [{ json: { ...prec, echec: { code: 'WORKFLOW_ERROR', message: 'YouTube (chaînes) : ' + detail } } }];\n}\nconst EMAIL = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i;\nconst rejetsFiltre = [];\nconst candidats = [];\nfor (const ch of r.body?.items ?? []) {\n  const s = ch.statistics ?? {};\n  const sn = ch.snippet ?? {};\n  const titre = (sn.title || ch.id).slice(0, 120);\n  const ecarter = (reasonCode, reason) => rejetsFiltre.push({ channelId: ch.id, channelTitle: titre, reasonCode, reason });\n  const abonnes = s.hiddenSubscriberCount ? null : Number(s.subscriberCount ?? 0);\n  if (ch.status?.madeForKids) { ecarter('made_for_kids', 'Chaîne destinée aux enfants'); continue; }\n  if (abonnes === null) { ecarter('insufficient_data', 'Nombre d’abonnés masqué'); continue; }\n  if (camp.minSubscribers !== null && abonnes < camp.minSubscribers) { ecarter('audience_too_small', abonnes + ' abonnés'); continue; }\n  if (camp.maxSubscribers !== null && abonnes > camp.maxSubscribers) { ecarter('audience_too_large', abonnes + ' abonnés'); continue; }\n  if (camp.countries.length && sn.country && !camp.countries.includes(sn.country)) { ecarter('country_mismatch', 'Pays déclaré : ' + sn.country); continue; }\n  const email = (sn.description ?? '').match(EMAIL)?.[0] ?? null;\n  candidats.push({\n    channelId: ch.id, titre, handle: sn.customUrl || null, description: (sn.description ?? '').slice(0, 4000),\n    pays: sn.country ?? null, langueParDefaut: sn.defaultLanguage ?? null, abonnes,\n    vues: Number(s.viewCount ?? 0), videos: Number(s.videoCount ?? 0),\n    avatar: sn.thumbnails?.default?.url ?? null, email, ...prec.chaines[ch.id],\n  });\n}\nreturn [{ json: { ...prec, rejetsFiltre, candidats: candidats.slice(0, cfg.maxCandidats), echec: null } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000021",
