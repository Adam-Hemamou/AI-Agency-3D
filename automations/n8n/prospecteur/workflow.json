    {
      "id": "c0a80001-0000-4000-8000-000000000028",
      "name": "Décision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [5940, -200],
      "parameters": {
        "jsCode": "const req = $('Requête Qwen3').first().json;\nconst c = req.candidat;\nconst plan = $('Plan de recherche').first().json;\nconst camp = $('Critères de la campagne').first().json.campaign;\nconst r = $input.first().json;\nconst CODES = ['off_target', 'no_dubbing_potential', 'language_mismatch', 'insufficient_data', 'other'];\nconst erreur = r.error ? (typeof r.error === 'string' ? r.error : (r.error.message ?? 'erreur inconnue')) : null;\nif (erreur || !r.message) {\n  return [{ json: { action: 'erreur_llm', channelId: c.channelId, message: erreur ?? 'réponse vide' } }];\n}\nconst tokens = { prompt: r.prompt_eval_count ?? 0, sortie: r.eval_count ?? 0, ms: Math.round((r.total_duration ?? 0) / 1e6) };\nlet q = null;\ntry { q = JSON.parse(r.message.content); } catch (e) { q = null; }\nconst texte = (v) => typeof v === 'string' && v.trim().length > 0;\nif (!q || typeof q.retenir !== 'boolean' || ![q.motif, q.adequation, q.interet, q.observation].every(texte)) {\n  return [{ json: { action: 'invalide', channelId: c.channelId, tokens, brut: String(r.message.content ?? '').slice(0, 1000) } }];\n}\nif (!q.retenir) {\n  const reasonCode = CODES.includes(q.code_rejet) ? q.code_rejet : 'other';\n  return [{ json: { action: 'rejeter', channelId: c.channelId, tokens, rejet: { channelId: c.channelId, channelTitle: c.titre, reasonCode, reason: q.motif.trim().slice(0, 500) } } }];\n}\nconst manquantes = Array.isArray(q.informations_manquantes) ? q.informations_manquantes.filter(texte).slice(0, 10) : [];\nconst prospect = {\n  missionId: plan.missionId,\n  creatorName: c.titre,\n  channelName: c.titre,\n  youtubeChannelId: c.channelId,\n  channelHandle: c.handle,\n  channelUrl: 'https://www.youtube.com/channel/' + c.channelId,\n  avatarUrl: c.avatar,\n  description: c.description || null,\n  country: c.pays,\n  subscriberCount: c.abonnes,\n  viewCount: c.vues,\n  videoCount: c.videos,\n  statsSource: 'YouTube Data API v3 (channels.list)',\n  statsUpdatedAt: new Date().toISOString(),\n  contactEmail: c.email,\n  contactSource: c.email ? 'https://www.youtube.com/channel/' + c.channelId + '/about' : null,\n  discovery: {\n    source: 'YouTube Data API v3 (search.list)',\n    reason: q.motif.trim(),\n    keywords: c.motCle ? [c.motCle] : [],\n    criteria: camp.themes,\n    qualification: {\n      targetFit: q.adequation.trim(),\n      potentialInterest: q.interet.trim(),\n      firstObservation: q.observation.trim(),\n      missingInfo: manquantes,\n      transferReason: q.motif.trim(),\n    },\n  },\n};\nreturn [{ json: { action: 'creer', channelId: c.channelId, tokens, prospect } }];"
      }
    },
