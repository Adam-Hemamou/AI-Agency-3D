      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [7040, -300],
      "parameters": {
        "jsCode": "const d = $('Décision').first().json;\nconst creation = $('CRM – créer le prospect').first().json;\nif (creation.statusCode === 201) {\n  const passage = $input.first().json;\n  return [{ json: { action: 'cree', channelId: d.channelId, reference: creation.body.prospect.reference, enAnalyse: passage.statusCode === 200, tokens: d.tokens } }];\n}\nconst code = creation.body?.error?.code;\nconst action = code === 'ALREADY_EXISTS' ? 'doublon'\n  : code === 'CAMPAIGN_TARGET_REACHED' ? 'objectif_atteint'\n  : code === 'QUOTA_EXCEEDED' ? 'quota_atteint'\n  : 'refus_crm';\nconst message = creation.body?.error?.message ?? creation.error?.message ?? null;\nreturn [{ json: { action, channelId: d.channelId, message, tokens: d.tokens } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000034",
      "name": "Bilan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [5280, -500],
      "parameters": {
        "jsCode": "const plan = $('Plan de recherche').first().json;\nconst f = $('Filtrer et préparer').first().json;\nconst res = $input.all().map((i) => i.json).filter((j) => !j.aucun);\nconst compter = (a) => res.filter((r) => r.action === a).length;\nconst rejets = [...f.rejetsFiltre, ...res.filter((r) => r.action === 'rejeter').map((r) => r.rejet)].slice(0, 50);\nconst erreursLlm = res.filter((r) => r.action === 'erreur_llm');\nconst tokens = res.reduce((t, r) => ({\n  prompt: t.prompt + (r.tokens?.prompt ?? 0), sortie: t.sortie + (r.tokens?.sortie ?? 0), ms: t.ms + (r.tokens?.ms ?? 0),\n}), { prompt: 0, sortie: 0, ms: 0 });\nconst stats = {\n  recherches: plan.recherches.length,\n  chainesTrouvees: f.ids.length,\n  dejaConnues: f.dejaConnues,\n  nouvelles: f.nouvelles.length,\n  ecarteesParFiltre: f.rejetsFiltre.length,\n  evalueesParQwen3: res.length,\n  prospectsCrees: compter('cree'),\n  references: res.filter((r) => r.action === 'cree').map((r) => r.reference),\n  ecarteesParQwen3: compter('rejeter'),\n  doublons: compter('doublon'),\n  objectifAtteint: compter('objectif_atteint') > 0,\n  quotaGlobalAtteint: compter('quota_atteint') > 0,\n  reponsesInvalides: compter('invalide'),\n  erreursQwen3: erreursLlm.length,\n  refusCrm: compter('refus_crm'),\n  tokens,\n};\n// Aucune qualification possible (Ollama injoignable) : échec, le CRM décide de la suite.\nconst echec = res.length > 0 && erreursLlm.length === res.length\n  ? { code: 'LLM_UNAVAILABLE', message: 'Qwen3 / Ollama : ' + erreursLlm[0].message }\n  : null;\nreturn [{ json: { ...plan, rejets, stats, echec } }];"
      }
    },
