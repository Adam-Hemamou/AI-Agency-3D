    {
      "id": "c0a80001-0000-4000-8000-000000000009",
      "name": "Plan de recherche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 300],
      "parameters": {
        "jsCode": "const cfg = $('Configuration').first().json;\nconst claim = $('Prendre une mission').first().json.body;\nconst ctx = $('Critères de la campagne').first().json;\nconst c = ctx.campaign;\nconst base = { missionId: claim.mission.id, runId: claim.run.id };\nif (!c.enabled || ctx.progress.remaining <= 0) {\n  const fin = c.enabled ? 'objectif du jour déjà atteint' : 'campagne désactivée';\n  return [{ json: { ...base, recherches: [], fin } }];\n}\n// Mots-clés différents chaque jour (rotation), dans la limite du quota YouTube (100 unités par recherche).\nconst n = Math.min(cfg.maxRecherches, c.keywords.length);\nconst debut = Number(ctx.mission.day.replaceAll('-', '')) % c.keywords.length;\nconst motsCles = Array.from({ length: n }, (_, i) => c.keywords[(debut + i) % c.keywords.length]);\nconst depuis = new Date(Date.now() - c.maxDaysSinceLastVideo * 86400000).toISOString().replace(/\\.\\d{3}Z$/, 'Z');\nconst recherches = motsCles.map((motCle) => {\n  const query = { part: 'snippet', type: 'video', q: motCle, maxResults: 50, order: 'relevance', publishedAfter: depuis };\n  if (c.languages.length) query.relevanceLanguage = c.languages[0];\n  if (c.countries.length) query.regionCode = c.countries[0];\n  return { motCle, query };\n});\nreturn [{ json: { ...base, recherches, fin: null } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000010",
      "name": "Recherches à faire ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "if-3",
              "leftValue": "={{ $json.recherches.length > 0 }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000011",
      "name": "Une recherche par mot-clé",
