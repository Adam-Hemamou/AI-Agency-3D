    },
    {
      "id": "c0a80001-0000-4000-8000-000000000023",
      "name": "Un candidat par élément",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4840, -200],
      "parameters": {
        "jsCode": "const f = $('Filtrer et préparer').first().json;\n// Toujours au moins un élément : la boucle s'exécute et le bilan est atteint même sans candidat.\nreturn f.candidats.length ? f.candidats.map((c) => ({ json: c })) : [{ json: { aucun: true } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000024",
      "name": "Pour chaque candidat",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [5060, -200],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000025",
      "name": "Candidat réel ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [5280, -100],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "if-8",
              "leftValue": "={{ !$json.aucun }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000026",
      "name": "Requête Qwen3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [5500, -200],
      "parameters": {
        "jsCode": "const P = $('Profil agent').first().json;\nconst camp = $('Critères de la campagne').first().json.campaign;\nconst c = $input.first().json;\nconst s = P.settings;\nconst SCHEMA = {\n  type: 'object',\n  properties: {\n    retenir: { type: 'boolean' },\n    code_rejet: { type: 'string', enum: ['aucun', 'off_target', 'no_dubbing_potential', 'language_mismatch', 'insufficient_data', 'other'] },\n    motif: { type: 'string' },\n    adequation: { type: 'string' },\n    interet: { type: 'string' },\n    observation: { type: 'string' },\n    informations_manquantes: { type: 'array', items: { type: 'string' } },\n  },\n  required: ['retenir', 'code_rejet', 'motif', 'adequation', 'interet', 'observation', 'informations_manquantes'],\n};\nconst donnees = {\n  campagne: { thematiques: camp.themes, motsCles: camp.keywords, langues: camp.languages, pays: camp.countries },\n  chaine: {\n    titre: c.titre, identifiant: c.handle, pays: c.pays, langueParDefaut: c.langueParDefaut,\n    abonnes: c.abonnes, vues: c.vues, videos: c.videos,\n    derniereVideo: c.derniereVideo, titreDerniereVideo: c.titreVideo, description: c.description,\n  },\n};\nconst body = {\n  model: s.model, stream: false, think: s.think, format: SCHEMA,\n  options: { temperature: s.temperature, top_p: s.topP, top_k: s.topK, num_ctx: s.numCtx, num_predict: s.numPredict },\n  messages: [\n    { role: 'system', content: P.prompt.systemPrompt },\n    { role: 'user', content: JSON.stringify(donnees) },\n  ],\n};\nreturn [{ json: { candidat: c, body, timeoutMs: s.timeoutSeconds * 1000 } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000027",
      "name": "Qwen3 – qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [5720, -200],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
