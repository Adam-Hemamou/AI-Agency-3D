    {
      "id": "c0a80001-0000-4000-8000-000000000017",
      "name": "Nouvelles chaînes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3520, 0],
      "parameters": {
        "jsCode": "const prec = $('Chaînes trouvées').first().json;\nconst etat = $input.first().json.items ?? [];\nconst nouvelles = etat.filter((c) => c.status === 'new').map((c) => c.channelId);\nreturn [{ json: { ...prec, nouvelles, dejaConnues: etat.length - nouvelles.length } }];"
      }
    },
    {
      "id": "c0a80001-0000-4000-8000-000000000018",
